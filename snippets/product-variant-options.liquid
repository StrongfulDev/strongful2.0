{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} Type of picker.
  - myBlock: {Object} block object.
  - announcement_tag: {String} announcement tag.
  - members_only_sale: {Boolean} members only sale.

  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block,
    myBlock: myBlock,
    announcement_tag: settings.announcement_tag,
    members_only_sale: settings.members_only_sale
  %}
{% endcomment %}
{%- liquid
    assign variants_available_arr = product.variants | map: 'available'
    assign variants_option1_arr = product.variants | map: 'option1'
    assign variants_option2_arr = product.variants | map: 'option2'
    assign variants_option3_arr = product.variants | map: 'option3'
    assign product_form_id = 'product-form-' | append: section.id
    for variant in product.variants
        assign variant_id = variant.id
    endfor
-%}

{% if block.settings.picker_type == 'button' or picker_type == "button" %}
  {% if option.name == "Color" or option.name == "צבע" %}
    <div class="color-variant-wrapper">
      {%- for value in option.values -%}
        {%- liquid
            assign option_disabled = true
            assign members_only = false
            if announcement_tag != blank and members_only_sale_active == true
              assign members_only = true
            endif
            if members_only == true
              if customer and members_only_sale_active == true
                assign members_only = false
              else
                assign members_only = true
              endif
            endif
            for option1_name in variants_option1_arr
              case option.position
                when 1
                  if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
                when 2
                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
                when 3
                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
              endcase
            endfor
        -%}
        {% assign option_value = value %}
        <span class="{{ loggedIn }} variant-button {% if option_disabled or loggedIn == false or members_only == true and product.tags contains announcement_tag %}disabled-variant-button{% endif %} {{ option_value }}">
          <input
              type="radio"
              id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
              name="{{ option.name }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              data-variant-id="{{ variant_id }}"
              {% if members_only == true and product.tags contains announcement_tag %}
                disabled class="disabled disabled-variant-button"
              {% elsif loggedIn == false %}
                disabled class="disabled disabled-variant-button"
              {% elsif option_disabled %}
                class="disabled disabled-variant-button"
              {% endif %}
          >
          {% assign variant = product.variants | where: 'option1', value | first %}
          {% assign variant_color = variant.metafields.custom.variant_color %}
          <label class="no-background color-variant-tile"
                 for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
              <span style="background-color: {{ variant_color }}">&nbsp;</span>
          </label>
        </span>
      {%- endfor -%}
    </div>
  {% else %}
    <div class="size-variant-wrapper">
      {%- for value in option.values -%}
        {%- liquid
            assign option_disabled = true
            assign members_only = false
            if announcement_tag != blank and members_only_sale_active == true
              assign members_only = true
            endif
            if members_only == true
              if customer and members_only_sale_active == true
                assign members_only = false
              else
                assign members_only = true
              endif
            endif
            for option1_name in variants_option1_arr
              case option.position
                when 1
                  if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
                when 2
                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
                when 3
                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0] or members_only == true and product.tags contains announcement_tag and members_only_sale_active == true or loggedIn == false
                    assign option_disabled = false
                  endif
              endcase
            endfor
        -%}
        {% assign option_value = value %}
        <span class="{{ loggedIn }} variant-button {% if option_disabled or loggedIn == false or members_only == true and product.tags contains announcement_tag %}disabled-variant-button{% endif %} {{ option_value }}">
          <input
              type="radio"
              id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
              name="{{ option.name }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              data-variant-id="{{ variant_id }}"
              {% if members_only == true and product.tags contains announcement_tag %}
                disabled class="disabled disabled-variant-button"
              {% elsif loggedIn == false %}
                disabled class="disabled disabled-variant-button"
              {% elsif option_disabled %}
                class="disabled disabled-variant-button"
              {% endif %}
          >
          <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
            {{ value -}}
            <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
          </label>
        </span>
      {%- endfor -%}
    </div>
  {% endif %}
{% elsif block.settings.picker_type == 'dropdown' %}
  <select name="{{ option.name }}">
    {%- for value in option.values -%}
      <option value="{{ value | escape }}">
        {% if option_disabled %}
          {{- 'products.product.value_unavailable' | t: option_value: value -}}
        {% else %}
          {{- value -}}
        {% endif %}
      </option>
    {%- endfor -%}
  </select>
{% endif %}