  <!-- ====== Simple JavaScript to Switch Tables ====== -->
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      // Select all pill buttons
      var pills = document.querySelectorAll('.size-switch');
      // Select all size chart divs
      var charts = document.querySelectorAll('.size-chart');

      // A helper function to hide all charts
      function hideAllCharts() {
        charts.forEach(function(chart){
          chart.style.display = 'none';
        });
        pills.forEach(function(pill){
          pill.classList.remove('active');
        });
      }

      // By default, show the first tab (אוברול)
      hideAllCharts();
      var defaultChart = document.getElementById('onesie-chart');
      var defaultPill = pills[0];
      if (defaultChart && defaultPill) {
        defaultChart.style.display = 'block';
        defaultPill.classList.add('active');
      }

      // Add click event to each pill
      pills.forEach(function(pill){
        pill.addEventListener('click', function(){
          var targetID = this.getAttribute('data-target');
          hideAllCharts();
          var targetChart = document.getElementById(targetID);
          if (targetChart) {
            targetChart.style.display = 'block';
          }
          this.classList.add('active');
        });
      });
    });
  </script>
