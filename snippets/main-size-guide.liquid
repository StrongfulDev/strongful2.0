{% comment %}
  A stand-alone size guide with pill navigation.
  Does NOT rely on product variants or metafields.
  Includes separate tables for multiple product types:
  1. אוברול (Onesie)
  2. חולצה (Shirt)
  3. מכנס (Pants)
  You can add more if needed.
{% endcomment %}

<div dir="rtl" style="text-align: right; font-family: sans-serif;">

  <!-- ====== Basic Styles for Pills & Tables ====== -->
  <style>
    .product-size-switch-container {
      margin-bottom: 1rem;
    }
    .size-switch {
      display: inline-block;
      padding: 0.5em 1em;
      margin: 0 0.5em 0.5em 0;
      border: 1px solid #ccc;
      border-radius: 30px; /* pill shape */
      cursor: pointer;
      background: #fff;
      transition: background-color 0.3s, color 0.3s;
    }
    .size-switch.active {
      background-color: #000;
      color: #fff;
    }
    .size-chart {
      display: none; /* hidden by default; toggled by JS */
      border: 1px solid #ddd;
      padding: 1em;
      border-radius: 6px;
      margin-bottom: 1em;
    }
    .size-chart table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1em;
    }
    .size-chart th, .size-chart td {
      border: 1px solid #ddd;
      padding: 0.5em;
      text-align: center;
    }
    .size-chart th {
      background-color: #f9f9f9;
    }
    .note {
      margin-top: 1em;
      font-size: 0.9em;
      color: #666;
    }
  </style>

  <!-- ====== Pills Navigation ====== -->
  <div class="product-size-switch-container">
    <span class="size-switch" data-target="onesie-chart">אוברול</span>
    <span class="size-switch" data-target="shirt-chart">חולצה</span>
    <span class="size-switch" data-target="pants-chart">מכנס</span>
    <!-- Add more pills if you want more product types -->
  </div>

