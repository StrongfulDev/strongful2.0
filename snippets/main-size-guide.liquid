      <script>
      document.addEventListener('DOMContentLoaded', function(){
        // Pill logic as before
        var pills = document.querySelectorAll('.size-switch');
        var charts = document.querySelectorAll('.size-chart');

        function hideAllCharts() {
          charts.forEach(function(chart){ chart.style.display = 'none'; });
          pills.forEach(function(pill){ pill.classList.remove('active'); });
        }
        hideAllCharts();
        // Show the first chart by default
        document.getElementById('onesie-chart').style.display = 'block';
        pills[0].classList.add('active');

        pills.forEach(function(pill){
          pill.addEventListener('click', function(){
            var targetID = this.getAttribute('data-target');
            hideAllCharts();
            document.getElementById(targetID).style.display = 'block';
            this.classList.add('active');
          });
        });
      });
      </script>
