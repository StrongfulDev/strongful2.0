      document.addEventListener('DOMContentLoaded', function(){
        // Pill logic as before
        var pills = document.querySelectorAll('.size-switch');
        var charts = document.querySelectorAll('.size-chart');

        function hideAllCharts() {
          charts.forEach(function(chart){ chart.style.display = 'none'; });
          pills.forEach(function(pill){ pill.classList.remove('active'); });
        }
        hideAllCharts();
        // Show the first chart by default
        document.getElementById('onesie-chart').style.display = 'block';
        pills[0].classList.add('active');

        pills.forEach(function(pill){
          pill.addEventListener('click', function(){
            var targetID = this.getAttribute('data-target');
            hideAllCharts();
            document.getElementById(targetID).style.display = 'block';
            this.classList.add('active');
          });
        });

        // Auto-select the tab based on product type
        var productType = "{{ product.type }}";
        var target = "";
        if(productType.indexOf("אוברול") !== -1) {
            target = "onesie-chart";
        } else if(productType.indexOf("חזיית ספורט") !== -1 || productType.indexOf("טופ") !== -1 || productType.indexOf("קרופ") !== -1) {
            target = "shirt-chart";
        } else if(productType.indexOf("טייץ") !== -1 || productType.indexOf("מכנס") !== -1 || productType.indexOf("בייקר") !== -1) {
            target = "pants-chart";
        } else if(productType.indexOf("חולצה") !== -1 || productType.indexOf("ג׳קט") !== -1) {
            target = "jacket-chart";
        }

        if(target){
            hideAllCharts();
            document.getElementById(target).style.display = 'block';
            pills.forEach(function(pill){
                if(pill.getAttribute("data-target") === target) {
                    pill.classList.add("active");
                }
            });
        }
      });
      </script>
