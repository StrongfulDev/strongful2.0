<div class="container">
  <div class="photo-desktop">
    {% if section.settings.photo != blank %}
      <img src="{{ section.settings.photo | img_url: 'original' }}" alt="{{ section.settings.alt_text }}">
    {% else %}
      <img src="{{ 'placeholder.jpg' | asset_url }}" alt="Placeholder">
    {% endif %}
  </div>
  <div class="form-section">
    {% if section.settings.header_text != blank %}
      <h4 class="form-header">{{ section.settings.header_text }}</h4>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="form-description">{{ section.settings.description }}</p>
    {% endif %}
    <form action="#" method="post" class="subscribe-form">
      <div class="form-group">
        <input type="email" id="email" name="email" placeholder="דואר אלקטרוני*" required>
      </div>
      <div class="form-group">
        <input type="text" id="fullname" name="fullname" placeholder="שם מלא*" required>
      </div>
      <div class="form-group">
        <input type="tel" id="cell" name="cell" placeholder="טלפון נייד*" required>
      </div>
      <div class="form-group">
        <input type="date" id="birthday" name="birthday" placeholder="תאריך לידה*" required>
      </div>
      <button type="submit" class="btn-submit">Submit</button>
    </form>
  </div>
  <div class="photo-mobile">
    {% if section.settings.mobile_photo != blank %}
      <img src="{{ section.settings.mobile_photo | img_url: 'original' }}" alt="{{ section.settings.alt_text }}">
    {% else %}
      <img src="{{ 'placeholder_mobile.jpg' | asset_url }}" alt="Placeholder Mobile">
    {% endif %}
  </div>
</div>

<style>
/* 1) Container & general layout */
.container {
  max-width: 1440px;
  margin: 0 auto;
}

@media (min-width: 769px) {
  .container {
    display: flex;
    gap: 20px;
  }
  .photo-desktop {
    flex: 0 0 64.4%;
  }
  .form-section {
    flex: 0 0 35.6%;
    display: flex;
    flex-direction: column;
    justify-content: center; /* Align form vertically in the available space */
    padding: 40px 20px; /* Adjust spacing to taste */
  }
  .photo-mobile {
    display: none;
  }
}

@media (max-width: 768px) {
  .container {
    display: block;
    padding: 20px;
  }
  .photo-desktop {
    display: none;
  }
  .photo-mobile {
    display: block;
    margin-bottom: 20px;
  }
}

/* 2) Form & input styling */
.form-header {
  font-size: 2rem;
  font-weight: bold;
  margin-bottom: 1rem;
  text-align: center;
}

.form-description {
  margin-bottom: 1.5rem;
  font-size: 1rem; /* Adjust if you want a bigger or smaller text */
  line-height: 1.4;
}

.subscribe-form {
  display: flex;
  flex-direction: column;
}

.form-group {
  margin-bottom: 1.2rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  font-size: 0.95rem;
}

.form-group input {
  width: 100%;
  padding: 0.6rem 0.8rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 0.95rem;
}

/* 3) Button styling */
.btn-submit {
  padding: 0.8rem 1.2rem;
  background-color: #000; /* Use brand color if you have one */
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  transition: background-color 0.2s ease-in-out;
}

.btn-submit:hover {
  background-color: #333; /* Slight hover effect */
}
</style>

{% schema %}
{
  "name": "Subscribe Section",
  "settings": [
    {
      "type": "text",
      "id": "header_text",
      "label": "Header Text",
      "default": "Subscribe Now"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Desktop Photo",
      "info": "Uploads: Desktop image at 928×731."
    },
    {
      "type": "image_picker",
      "id": "mobile_photo",
      "label": "Mobile Photo",
      "info": "Uploads: Mobile image to be shown exclusively on mobile (392×392)."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Photo Alt Text",
      "default": "Placeholder Image"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Some descriptive text goes here alongside the form."
    }
  ]
}
{% endschema %}