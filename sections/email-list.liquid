<div class="container">
  <div class="photo-desktop">
    {% if section.settings.photo != blank %}
      <img src="{{ section.settings.photo | img_url: 'original' }}" alt="{{ section.settings.alt_text }}">
    {% else %}
      <img src="{{ 'placeholder.jpg' | asset_url }}" alt="Placeholder">
    {% endif %}
  </div>
  <div class="form-section">
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
    <form action="#" method="post">
      <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group">
        <label for="fullname">Full Name:</label>
        <input type="text" id="fullname" name="fullname" required>
      </div>
      <div class="form-group">
        <label for="cell">Cell Number:</label>
        <input type="tel" id="cell" name="cell" required>
      </div>
      <div class="form-group">
        <label for="birthday">Birthday:</label>
        <input type="date" id="birthday" name="birthday" required>
      </div>
      <button type="submit">Submit</button>
    </form>
  </div>
  <div class="photo-mobile">
    {% if section.settings.mobile_photo != blank %}
      <img src="{{ section.settings.mobile_photo | img_url: 'original' }}" alt="{{ section.settings.alt_text }}">
    {% else %}
      <img src="{{ 'placeholder_mobile.jpg' | asset_url }}" alt="Placeholder Mobile">
    {% endif %}
  </div>
</div>

<style>
/* Set max container width on desktop */
.container {
  max-width: 1440px;
  margin: 0 auto;
}

/* Desktop styling */
@media (min-width: 769px) {
  .container {
    display: flex;
    gap: 20px;
  }
  /* Desktop image takes 64.4% of 1440px */
  .photo-desktop {
    flex: 0 0 64.4%;
  }
  /* Form takes the rest (35.6%) */
  .form-section {
    flex: 0 0 35.6%;
  }
  /* Hide mobile image */
  .photo-mobile {
    display: none;
  }
}

/* Mobile styling */
@media (max-width: 768px) {
  .container {
    display: block;
    padding: 20px;
  }
  /* On mobile, hide desktop image and show mobile image */
  .photo-desktop { display: none; }
  .photo-mobile { display: block; }
}
</style>

{% schema %}
{
  "name": "Subscribe Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Desktop Photo",
      "info": "Uploads: Desktop image at 928×731."
    },
    {
      "type": "image_picker",
      "id": "mobile_photo",
      "label": "Mobile Photo",
      "info": "Uploads: Mobile image to be shown exclusively on mobile (392×392)."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Photo Alt Text",
      "default": "Placeholder Image"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Some descriptive text goes here alongside the form."
    }
  ]
}
{% endschema %}