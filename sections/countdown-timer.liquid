{% comment %}
  sections/countdown-timer.liquid
{% endcomment %}

{% schema %}
{
  "name": "Countdown Timer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Offer!"
    },
    {
      "type": "datetime",
      "id": "end_time",
      "label": "End Date and Time"
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Color Theme",
      "options": [
        {
          "value": "default",
          "label": "Default Blue"
        },
        {
          "value": "urgent",
          "label": "Urgent Red"
        },
        {
          "value": "dark",
          "label": "Dark Mode"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_fomo",
      "label": "Show FOMO Elements",
      "default": true
    },
    {
      "type": "range",
      "id": "viewer_count_min",
      "label": "Minimum Viewer Count",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "viewer_count_max",
      "label": "Maximum Viewer Count",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<div
  class="countdown-timer countdown-timer--{{ section.settings.theme }}"
  data-end-time="{{ section.settings.end_time }}"
  data-show-fomo="{{ section.settings.show_fomo }}"
>
  <div class="countdown-timer__content">
    <h2 class="countdown-timer__heading">{{ section.settings.heading }}</h2>

    <div class="countdown-timer__display">
      <div class="countdown-unit">
        <span class="countdown-value" data-unit="days">00</span>
        <span class="countdown-label">Days</span>
      </div>
      <div class="countdown-unit">
        <span class="countdown-value" data-unit="hours">00</span>
        <span class="countdown-label">Hours</span>
      </div>
      <div class="countdown-unit">
        <span class="countdown-value" data-unit="minutes">00</span>
        <span class="countdown-label">Minutes</span>
      </div>
      <div class="countdown-unit">
        <span class="countdown-value" data-unit="seconds">00</span>
        <span class="countdown-label">Seconds</span>
      </div>
    </div>

    {% if section.settings.show_fomo %}
      <div class="countdown-timer__fomo">
        <div class="fomo-viewers">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span class="viewer-count">Loading...</span> people are viewing this right now
        </div>
        <div class="fomo-stock">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          Only <span class="stock-count">Loading...</span> items left at this price!
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .countdown-timer {
    padding: 2rem;
    margin: 2rem 0;
    border-radius: 0.5rem;
    text-align: center;
  }

  .countdown-timer--default {
    background-color: #2563eb;
    color: white;
  }

  .countdown-timer--urgent {
    background-color: #dc2626;
    color: white;
  }

  .countdown-timer--dark {
    background-color: #1f2937;
    color: white;
  }

  .countdown-timer__heading {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
  }

  .countdown-timer__display {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4rem;
  }

  .countdown-value {
    font-size: 2rem;
    font-weight: bold;
  }

  .countdown-label {
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .countdown-timer__fomo {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .fomo-viewers,
  .fomo-stock {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  @media screen and (max-width: 640px) {
    .countdown-unit {
      min-width: 3rem;
    }

    .countdown-value {
      font-size: 1.5rem;
    }

    .countdown-label {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  class CountdownTimer {
    constructor(element) {
      this.element = element;
      this.endTime = new Date(element.dataset.endTime).getTime();
      this.showFomo = element.dataset.showFomo === 'true';
      this.timeElements = {
        days: element.querySelector('[data-unit="days"]'),
        hours: element.querySelector('[data-unit="hours"]'),
        minutes: element.querySelector('[data-unit="minutes"]'),
        seconds: element.querySelector('[data-unit="seconds"]')
      };

      if (this.showFomo) {
        this.viewerElement = element.querySelector('.viewer-count');
        this.stockElement = element.querySelector('.stock-count');
        this.initFomo();
      }

      this.updateTimer();
      this.timer = setInterval(() => this.updateTimer(), 1000);
    }

    updateTimer() {
      const now = new Date().getTime();
      const distance = this.endTime - now;

      if (distance < 0) {
        clearInterval(this.timer);
        this.element.style.display = 'none';
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      this.timeElements.days.textContent = String(days).padStart(2, '0');
      this.timeElements.hours.textContent = String(hours).padStart(2, '0');
      this.timeElements.minutes.textContent = String(minutes).padStart(2, '0');
      this.timeElements.seconds.textContent = String(seconds).padStart(2, '0');
    }

    initFomo() {
      const minViewers = {{ section.settings.viewer_count_min }};
      const maxViewers = {{ section.settings.viewer_count_max }};
      const updateFomo = () => {
        const viewers = Math.floor(Math.random() * (maxViewers - minViewers + 1)) + minViewers;
        const stock = Math.floor(Math.random() * 10) + 1;

        this.viewerElement.textContent = viewers;
        this.stockElement.textContent = stock;
      };

      updateFomo();
      setInterval(updateFomo, 30000); // Update every 30 seconds
    }
  }

  // Initialize all countdown timers on the page
  document.addEventListener('DOMContentLoaded', () => {
    const timers = document.querySelectorAll('.countdown-timer');
    timers.forEach(timer => new CountdownTimer(timer));
  });
</script>
