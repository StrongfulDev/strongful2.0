<div class="featured-two-box container">
  <div class="featured-two-box__info">
    {% if section.settings.title != blank %}
      <h2 class="featured-two-box__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="featured-two-box__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="featured-two-box__cta">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
  <div class="featured-two-box__products">
    {% for product in section.settings.collection.products limit:5 %}
      <div class="product-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img class="product-card__image" src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
          {% endif %}
          <h3 class="product-card__title">{{ product.title }}</h3>
        </a>
        <div class="product-card__rating" data-product-id="{{ product.id }}">
          <!-- Yotpo integration: replace or augment this with your Yotpo snippet/JS as required -->
          <div class="yotpo yotpo-custom-show" data-product-id="{{ product.id }}">
            <!-- Yotpo stars will render here if Yotpo is properly integrated -->
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .featured-two-box.container {
    display: flex;
    flex-wrap: wrap;
    box-sizing: border-box;
  }
  .featured-two-box__info {
    flex: 0 0 30%;
    padding: 1rem;
    box-sizing: border-box;
  }
  .featured-two-box__products {
    flex: 0 0 70%;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem;
    box-sizing: border-box;
  }
  .product-card {
    flex: 1 1 calc(50% - 1rem);
    box-sizing: border-box;
    padding: 0.5rem;
    border: 1px solid #eaeaea;
    text-align: center;
  }
  .product-card__image {
    max-width: 100%;
    height: auto;
  }
  /* Responsive adjustments */
  @media (max-width: 750px) {
    .featured-two-box.container {
      flex-direction: column;
    }
    .featured-two-box__info,
    .featured-two-box__products {
      flex: 1 1 100%;
    }
    .product-card {
      flex: 1 1 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Two Boxes",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured Collection",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Shop our best sellers",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "default": "View All",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "default": "/collections/all",
      "label": "CTA Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Two Boxes"
    }
  ]
}
{% endschema %}