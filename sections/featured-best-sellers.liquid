<div class="featured-two-box container">
  <div class="featured-two-box__info">
    {% if section.settings.title != blank %}
      <h4 class="featured-two-box__title">{{ section.settings.title }}</h4>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <h2 class="featured-two-box__subheading">{{ section.settings.subheading }}</h2>
    {% endif %}
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="featured-two-box__cta">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
  <div class="featured-two-box__products">
    {% for product in section.settings.collection.products limit:5 %}
      <div class="product-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img class="product-card__image" src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
          {% endif %}
        </a>
        {%- if product.metafields.reviews.rating.value != blank -%}
          {% liquid
              assign rating_decimal = 0
              assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
              elsif decimal > 0.7
                  assign rating_decimal = 1
              endif
          %}
          <div class="rating"
               role="img"
               aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}">
            <span aria-hidden="true"
                  class="rating-star color-icon-{{ settings.accent_icons }}"
                  style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }};
                         --rating-max: {{ product.metafields.reviews.rating.value.scale_max }};
                         --rating-decimal: {{ rating_decimal }};">
            </span>
          </div>
        {%- endif -%}
        <h3 class="product-card__title">{{ product.title }}</h3>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .featured-two-box.container {
    display: flex;
    flex-wrap: wrap;
    box-sizing: border-box;
  }
  .featured-two-box__info {
    flex: 0 0 30%;
    padding-left: 10rem;
    box-sizing: border-box;
  }
  /* Increase heading and subheading sizes */
  .featured-two-box__title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .featured-two-box__subheading {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  /* CTA as black rectangle with text inside */
  .featured-two-box__cta {
    background-color: #000;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    display: inline-block;
    margin-top: 1rem;
  }
  .featured-two-box__products {
    flex: 0 0 70%;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    flex-wrap: nowrap; /* Prevent wrapping */
    overflow-x: auto; /* Allow scroll if needed */
  }
  .product-card {
    flex: 0 0 calc((100% - 4rem) / 5); /* Divide space for exactly 5 cards; adjust gap if needed */
    box-sizing: border-box;
    padding: 0.5rem;
    text-align: center;
  }
  .product-card__image {
    max-width: 100%;
    height: auto;
  }
  /* Responsive adjustments */
  @media (max-width: 750px) {
    .featured-two-box.container {
      flex-direction: column;
    }
    .featured-two-box__info,
    .featured-two-box__products {
      flex: 1 1 100%;
    }
    .featured-two-box__products {
      flex-wrap: wrap;
      overflow-x: visible;
    }
    .product-card {
      flex: 1 1 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Two Boxes",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured Collection",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Shop our best sellers",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "default": "View All",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "default": "/collections/all",
      "label": "CTA Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Two Boxes"
    }
  ]
}
{% endschema %}