<div class="featured-two-box container" style="position: relative; overflow: hidden; padding: 2rem 0; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="featured-two-box__info">
    {% if section.settings.title != blank %}
      <h4 class="featured-two-box__title desktop-title-adjust mobile-dir">
        {{ section.settings.title }}
      </h4>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="featured-two-box__subheading-wrap">
        <h2 class="featured-two-box__subheading desktop-subheading-adjust">
          {{ section.settings.subheading }}
        </h2>
      </div>
    {% endif %}

    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="featured-two-box__cta desktop-cta-adjust mobile-cta-adjust">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>

  <div class="featured-two-box__products">
    {% for product in section.settings.collection.products limit: section.settings.product_limit %}
      <div class="product-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img class="product-card__image"
                 src="{{ product.featured_image | img_url: 'large' }}"
                 alt="{{ product.title }}">
          {% endif %}
        </a>

        {%- if product.metafields.reviews.rating.value != blank -%}
          {% assign rating_value = product.metafields.reviews.rating.value.rating | plus: 0 %}
          {% assign scale_max = product.metafields.reviews.rating.value.scale_max | plus: 0 %}
          {% assign rating_percentage = rating_value | times: 100 | divided_by: scale_max | round %}
          <div class="rating"
               role="img"
               aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: scale_max }}">
            <div class="stars-container">
              <div class="stars-outer">
                <div class="stars-inner" style="width: {{ rating_percentage }}%; color: {{ section.settings.star_color }}; letter-spacing: {{ section.settings.star_spacing }};">
                  ★★★★★
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
          <script>console.log( product.vendor )</script>
        <h3 class="product-card__title">{{ product.title }} - {{ product.vendor }}</h3>
        {% case forloop.index %}
          {% when 1 %}
            {% if section.settings.product_text1 != blank %}
              <p class="product-card__review-text">{{ section.settings.product_text1 }}</p>
            {% endif %}
          {% when 2 %}
            {% if section.settings.product_text2 != blank %}
              <p class="product-card__review-text">{{ section.settings.product_text2 }}</p>
            {% endif %}
          {% when 3 %}
            {% if section.settings.product_text3 != blank %}
              <p class="product-card__review-text">{{ section.settings.product_text3 }}</p>
            {% endif %}
          {% when 4 %}
            {% if section.settings.product_text4 != blank %}
              <p class="product-card__review-text">{{ section.settings.product_text4 }}</p>
            {% endif %}
          {% when 5 %}
            {% if section.settings.product_text5 != blank %}
              <p class="product-card__review-text">{{ section.settings.product_text5 }}</p>
            {% endif %}
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  /* Ensure global font */
  .featured-two-box.container * {
    font-family:'Arimo';
  }
  
  /* Desktop styles */
  @media (min-width: 750px) {
    .featured-two-box.container {
      display: flex;
      flex-wrap: nowrap; /* no wrapping so both columns share the same fixed height */
      align-items: stretch; /* force children to use full container height */
      box-sizing: border-box;
      padding-right: 8rem;
    }
  }
  
  /* Force both columns to fill 100% of the container height */
  .featured-two-box__info,
  .featured-two-box__products {
    height: 100%;
  }
  
  /* Left column: fixed at 30% */
  .featured-two-box__info {
    flex: 0 0 30%;
    padding-left: 8rem;
    box-sizing: border-box;
  }
  
  /* Right column: allow growth (flex: 1) to fill remaining space */
  .featured-two-box__products {
    flex: 1 1 70%;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  
  /* Ensure both info and product areas fill the container height */
  .featured-two-box__info,
  .featured-two-box__products {
    height: 100%;
  }
  
  .featured-two-box__info {
    flex: 0 0 30%;
    padding-left: 8rem;
    box-sizing: border-box;
  }
  
  .featured-two-box__products {
    flex: 0 0 70%;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  
  @media (min-width: 750px) {
    .featured-two-box.container {
      display: flex;
      flex-wrap: wrap;
      box-sizing: border-box;
    }
    .featured-two-box__products{
    padding-right:8rem;
    }
  }
  .featured-two-box.wrap{
  align-items: flex-start;
  }
  .featured-two-box__info {
    flex: 0 0 30%;
    padding-left: 8rem;
    box-sizing: border-box;
  }
  .featured-two-box__title {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .featured-two-box__subheading {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .featured-two-box__cta {
    background-color: #000;
    color: #fff;
    text-decoration: none;
    padding: 1rem 1.5rem;
    display: inline-block;
    margin-top: 1rem;
  }
  .featured-two-box__products {
    flex: 0 0 70%;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    box-sizing: border-box;
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  .product-card {
    flex: 0 0 calc((100% - 4rem) / {{ section.settings.product_limit }});
    box-sizing: border-box;
    padding: 0.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: left;
  }
  .product-card__image {
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 750px) {
    .featured-two-box.container {
      flex-direction: column;
      margin-right:0;
    }
    .featured-two-box__info {
      width: 100%;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
      margin-bottom: 1rem;
      direction:rtl;
    }
    /* Remove any right-padding for products on mobile */
    {% if section.settings.mobile_display_mode == "vertical" %}
    .featured-two-box__products {
      /* Use grid layout for vertical scrolling */
      display: grid;
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: 1rem;
      overflow-x: visible;
    }
    .product-card {
      margin-right: 0;
    }
    {% else %}
    .featured-two-box__products {
      /* Default: slide sideways */
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: 0.5rem;
      width: 100%;
    }
    .product-card {
      flex: 0 0 auto;
      margin-right: 1rem;
    }
    {% endif %}

    .featured-two-box__subheading-wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-direction: column;
    }
    .featured-two-box__cta {
      background: none;
      color: gray;
      text-decoration: underline;
      padding: 0;
      margin-top: 0;
    }
  }
  .rating-star {
    min-width: 50px;
  }
  .rating-star {
    display: inline-block;
    font-size: 1.5rem;
    line-height: 1;
  }
  .rating-star:before {
    content: '★';
    color: gold;
  }
  .product-card .rating,
  .product-card__title {
    text-align: right;
    font-size:16px;
    font-weight:500;
    direction:rtl;
  }
  .product-card .rating .stars-outer {
    width: 100%;
    text-align: right;
  }
  .stars-container {
    text-align: right;
  }
  .stars-container {
    display: block;
    width: 100%;
    text-align: right !important;
  }
  .stars-container {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }
  .product-card .rating {
    align-self: flex-end;
    margin-top: 0.5rem;
  }
  .stars-container {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: left;
  }
  .product-card .rating {
    align-self: flex-end; 
    margin-top: 0.5rem;
  }
  .product-card__title {
    align-self: flex-end; 
    width: 100%;
    text-align: right;
    margin-top: 0.5rem;
  }
  .product-card__review-text {
    font-size: 14px;
    margin-top: 0.25rem;
    text-align: right;
  }
  .featured-two-box__subheading-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .featured-two-box__title {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .featured-two-box__subheading-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-direction: column;
  }
  @media (max-width: 750px) {
    .featured-two-box__subheading-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-direction: row;
  }
    .featured-two-box__cta {
      background: none;
      color: gray;
      text-decoration: underline;
      padding: 0;
      margin-top: 0;
    }
  }

  /* Mobile text direction override for title */
  @media (max-width: 750px) {
    .mobile-dir {
      direction: {{ section.settings.text_direction }};
    }
  }
  
  @media (min-width: 750px) {
    .mobile-dir {
      direction: ltr;
    }
  }

  /* Mobile: use selected title alignment and text direction */
  @media (max-width: 750px) {
    .featured-two-box__title {
      text-align: {{ section.settings.title_alignment }};
      direction: {{ section.settings.text_direction }};
    }
  }
  
  /* Desktop: force title to left alignment and LTR direction */
  @media (min-width: 750px) {
    .featured-two-box__title {
      text-align: left !important;
      direction: ltr !important;
    }
  }

  /* Desktop: use slider values for absolute positioning */
  @media (min-width: 750px) {
    .desktop-title-adjust {
      position: absolute;
      bottom: {{ section.settings.title_bottom }}%;
      left: {{ section.settings.title_left }}%;
    }
    .desktop-subheading-adjust {
      position: absolute;
      bottom: {{ section.settings.subheading_bottom }}%;
      left: {{ section.settings.subheading_left }}%;
    }
    .desktop-cta-adjust {
      position: absolute;
      bottom: {{ section.settings.cta_bottom }}%;
      left: {{ section.settings.cta_left }}%;
    }
    /* Optionally remove forced text-align */
    .featured-two-box__title {
      text-align: initial !important;
    }
  }

  /* Mobile: revert to static positioning and style CTA as underlined with no background */
  @media (max-width: 749px) {
    .featured-two-box__title {
      position: static;
      text-align: {{ section.settings.title_alignment }};
      direction: {{ section.settings.text_direction }};
    }
    .desktop-subheading-adjust,
    .desktop-cta-adjust {
      position: static;
    }
    .mobile-cta-adjust {
      text-decoration: underline;
      background: none;
      padding: 0;
    }
  }

  /* Desktop: use slider values for absolute CTA positioning */
  @media (min-width: 750px) {
    .desktop-cta-adjust {
      position: absolute;
      bottom: {{ section.settings.cta_bottom }}%;
      left: {{ section.settings.cta_left }}%;
    }
  }

  /* Mobile: CTA is styled as underlined text with no background */
  @media (max-width: 749px) {
    .mobile-cta-adjust {
      background: none;
      color: gray;
      text-decoration: underline;
      padding: 0;
      margin-top: 0;
    }
  }
  
  /* Remaining styles … */
</style>

{% schema %}
{
  "name": "Featured Two Boxes",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured Collection",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Shop our best sellers",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "default": "View All",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "default": "/collections/all",
      "label": "CTA Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "Number of Products to Display"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#ceb18f"
    },
    {
      "type": "text",
      "id": "star_spacing",
      "default": "2px",
      "label": "Star Letter Spacing (CSS value, e.g., 2px)"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_direction",
      "label": "Text Direction",
      "default": "ltr",
      "options": [
        {
          "value": "ltr",
          "label": "Left to Right"
        },
        {
          "value": "rtl",
          "label": "Right to Left"
        }
      ]
    },
    {
      "type": "text",
      "id": "product_text1",
      "default": "Review text #1",
      "label": "Review Text for 1st product"
    },
    {
      "type": "text",
      "id": "product_text2",
      "default": "Review text #2",
      "label": "Review Text for 2nd product"
    },
    {
      "type": "text",
      "id": "product_text3",
      "default": "Review text #3",
      "label": "Review Text for 3rd product"
    },
    {
      "type": "text",
      "id": "product_text4",
      "default": "Review text #4",
      "label": "Review Text for 4th product"
    },
    {
      "type": "text",
      "id": "product_text5",
      "default": "Review text #5",
      "label": "Review Text for 5th product"
    },
    {
      "type": "select",
      "id": "mobile_display_mode",
      "label": "Mobile Display Mode",
      "default": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal Scroll"
        },
        {
          "value": "vertical",
          "label": "Vertical Grid"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "title_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "Main Heading Bottom Position (%)"
    },
    {
      "type": "range",
      "id": "title_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "Main Heading Left Position (%)"
    },
    {
      "type": "range",
      "id": "subheading_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5,
      "label": "Subheading Bottom Position (%)"
    },
    {
      "type": "range",
      "id": "subheading_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5,
      "label": "Subheading Left Position (%)"
    },
    {
      "type": "range",
      "id": "cta_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "CTA Bottom Position (%)"
    },
    {
      "type": "range",
      "id": "cta_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "CTA Left Position (%)"
    }
  ],
  "presets": [
    {
      "name": "Featured Two Boxes"
    }
  ]
}
{% endschema %}