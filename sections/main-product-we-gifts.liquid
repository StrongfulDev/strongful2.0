            </defs>
          </svg>
          {{ translations.oneLastCheckTitle }}</div>
        <div class="wd-card-data-text s-amount">
          <span class="wd-card-data-title">{{ product.title }}</span>
          <span class="wd-card-data-description">{{ product.description }}</span>
        </div>
        <div class="gap-32">
          {%-if numImages > 1-%}
         
          <div class="wd-card-image hide-desktop">
            <div class="values-title yg-title s-amount hide-on-desktop cd-mobile">{{ translations.chooseDesgin }}</div>
                <div class="wd-image-container hide-desktop">
                    <svg
                      onclick="getImagesSrcWd('[{{product.images}}]','dec')"
                      width="13"
                      height="13"
                      viewBox="0 0 13 13"
