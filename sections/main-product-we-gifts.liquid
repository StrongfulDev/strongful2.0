<!--divdiv-->
<!--when only one image to seperate between classes-->
{%-if numImages == 1-%}
<div class="wd-card-image hide-desktop">
              <div class="values-title yg-title s-amount mb-16">{{ translations.yourGiftCard }}</div>
                <div class="wd-image-container one-image hide-desktop">
                
                  <div class="main-image-con">
                  <img
                    id="main-image"
                    class="image"
                    height="224px"
                    src="{{ product.images[0]  | product_img_url : 'original' }}" />
                    {%-if hideExampleCode == false-%}
                  <div class="wd-card-code">AAAA-AAAA-AAAA-AAAA</div>
                  {%-endif%}
                  <div class="wd-card-price">0{{ currencySymbol }}</div>
                  </div>
                </div>
                </div>
{%-endif-%}
              {%- if numImages > 1 -%}
                <div class="images-wrapper s-amount">
                  
                  <div class="designes-wrapper s-amount">
                    <input type="hidden" name="id" />


                    <div class="desigens">
                      <div class="values-title yg-title s-amount hide-mobile">{{ translations.chooseDesign }}</div>
                      {% for image in product.images %}
                        <label class="line-item-style" for="{{ image.src }}">
                          <p class="line-item-property__field">
                            <input type="hidden" name="properties[_Style-{{forloop.index}}]">
                            <input
                              style="opacity: 0;"
                              id="style-{{image.src}}"
                              class="stylebox"
                              type="checkbox"
                              name="properties[_Style-{{forloop.index}}]"
                              value="{{image.src}}">
                            <img
                              class="i-image"
                              src="{{ image.src | product_img_url: 'original' }}"
                              onclick="selcetStyle('{{ image.src }}')"
                              id="{{image.src}}"
                              width="102"
                              height="68" />
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
               
                {%- if useCustomAmount == false -%}
                  <div class="initial-values s-amount">

                    {%- for block in section.blocks -%}
                      {%- case block.type -%}
                        {%- when '@app' -%}
                        {% render block %}
                        {%- when 'text' -%}


                        {%- when 'popup' -%}
                        <modal-opener
                          class="product-popup-modal__opener no-js-hidden quick-add-hidden"
                          data-modal="#PopupModal-{{ block.id }}"
                          {{ block.shopify_attributes }}>
                          <button
                            id="ProductPopup-{{ block.id }}"
                            class="product-popup-modal__button link"
                            type="button"
                            aria-haspopup="dialog">
                            {{ block.settings.text | default: block.settings.page.title }}
                          </button>
                        </modal-opener>
                        <a href="{{ block.settings.page.url }}" class="product-popup-modal__button link no-js">
                          {{- block.settings.text -}}
                        </a>
                        {%- when 'variant_picker' -%}
                        {%- unless product.has_only_default_variant -%}
                          {%- if block.settings.picker_type == 'button' -%}
                            <variant-radios
                            style="width: 100%;"
                              class="no-js-hidden"
                              data-section="{{ section.id }}"
                              data-url="{{ product.url }}"
                              {{ block.shopify_attributes }}>
                              <div class="values-title">{{translations.chooseAmountText}}</div>
                              {%- for option in product.options_with_values -%}
                                <fieldset class="js product-form__input">
                                  {%- for value in option.values -%}
                                    <input
                                      type="radio"
                                      id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                      name="{{ option.id }}"
                                      value="{{ value | escape }}"
                                      class="variant-input"
                                      {% if option.selected_value == value %}
                                      checked
                                      {% endif %}>
                                    <div
                                      onclick="setInitialValue('{{ value }}','{{targetPrice}}','{{currencySymbol}}')"
                                      class="initial-val"
                                      id="{{value}}"
                                      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                                      <label class="label-value">
                                        {{ value }}
                                      </label>
                                    </div>
                                  {%- endfor -%}
                                </fieldset>
                              {%- endfor -%}

                              <script type="application/json">
                                {{ product.variants | json }}
                              </script>
                            </variant-radios>
                          {%- else -%}
                            <variant-selects
                              class="no-js-hidden"
                              data-section="{{ section.id }}"
                              data-url="{{ product.url }}"
                              {{ block.shopify_attributes }}>
                              <script type="application/json">
                                {{ product.variants | json }}
                              </script>
                            </variant-selects>
                          {%- endif -%}
                        {%- endunless -%}

                        {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

                        {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities | where: 'pick_up_enabled', true -%}

                        <pickup-availability
                          class="product__pickup-availabilities no-js-hidden quick-add-hidden"
                          {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
                          available
                          {% endif %}
                          data-root-url="{{ routes.root_url }}"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                          data-has-only-default-variant="{{ product.has_only_default_variant }}">
                          <template>
                            <pickup-availability-preview class="pickup-availability-preview">
                              {% render 'icon-unavailable' %}
                              <div class="pickup-availability-info">
                                <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
                                <button class="pickup-availability-button link link--text underlined-link">
                                  {{ 'products.product.pickup_availability.refresh' | t }}
                                </button>
                              </div>
                            </pickup-availability-preview>
                          </template>
                        </pickup-availability>
                      </div>
                      <div class="target-price-wrapper s-amount">
                        <div class="target-price-svg">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 18 18"
                            fill="none">
                            <circle
                              cx="9"
                              cy="9"
                              r="9"
                              fill="#FD6806"
                              fill-opacity="0.63" />
                            <path
                              fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M8.83333 8.33594C9.29357 8.33594 9.66667 8.70903 9.66667 9.16927V12.5026C9.66667 12.9628 9.29357 13.3359 8.83333 13.3359C8.3731 13.3359 8 12.9628 8 12.5026V9.16927C8 8.70903 8.3731 8.33594 8.83333 8.33594Z"
                              fill="#FDF9EE" />
                            <path
                              fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M8 5.83333C8 5.3731 8.3731 5 8.83333 5H8.84167C9.3019 5 9.675 5.3731 9.675 5.83333C9.675 6.29357 9.3019 6.66667 8.84167 6.66667H8.83333C8.3731 6.66667 8 6.29357 8 5.83333Z"
                              fill="#FDF9EE" />
                          </svg>
                        </div>
                        <div class="target-price-texts">
                          <span class="target-price-title">{{ translations.targetPriceTitle }}</span>
                          <span class="target-price-desc">{{ translations.targetPrice }}</span>
                        </div>
                      </div>
                      <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
                      {%- when 'rating' -%}
                      {%- if product.metafields.reviews.rating.value != blank -%}
                        {% liquid
            assign rating_decimal = 0
             assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
             if decimal >= 0.3 and decimal <= 0.7
              assign rating_decimal = 0.5
            elsif decimal > 0.7
              assign rating_decimal = 1
             endif
          %}
                        <div
                          class="rating"
                          role="img"
                          aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}">
                          <span
                            aria-hidden="true"
                            class="rating-star color-icon-{{ settings.accent_icons }}"
                            style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                        </div>


                      {%- endif -%}


                    {%- endcase -%}
                  {%- endfor -%}
                {%- else %}
                  <div class="custom-amount-wrapper s-amount">
                    <div class="values-title">{{ translations.customAmountTitle }}</div>
                    <span class="values-description">{{ translations.customAmountText }}</span>

                    <div class="input-container">
                      <input
                        type="text"
                        oninput="showBiggerMessageWithCustomValue('{{targetPrice}}','{{currencySymbol}}')"
                        class="styled-input custom-input custom-amount-input"
                        id="custom-amount-input"
                        placeholder="your placeholder" />
                      <label>{{ translations.customAmountTitle }}</label>
                      <div class="target-price-wrapper">
                        <div class="target-price-svg">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 18 18"
                            fill="none">
                            <circle
                              cx="9"
                              cy="9"
                              r="9"
                              fill="#FD6806"
                              fill-opacity="0.63" />
                            <path
                              fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M8.83333 8.33594C9.29357 8.33594 9.66667 8.70903 9.66667 9.16927V12.5026C9.66667 12.9628 9.29357 13.3359 8.83333 13.3359C8.3731 13.3359 8 12.9628 8 12.5026V9.16927C8 8.70903 8.3731 8.33594 8.83333 8.33594Z"
                              fill="#FDF9EE" />
                            <path
                              fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M8 5.83333C8 5.3731 8.3731 5 8.83333 5H8.84167C9.3019 5 9.675 5.3731 9.675 5.83333C9.675 6.29357 9.3019 6.66667 8.84167 6.66667H8.83333C8.3731 6.66667 8 6.29357 8 5.83333Z"
                              fill="#FDF9EE" />
                          </svg>
                        </div>
                        <div class="target-price-texts">
                          <span class="target-price-title">{{ translations.targetPriceTitle }}</span>
                          <span class="target-price-desc">{{ translations.targetPrice }}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
                {%- if shopPlan == 'Business' or shopPlan == "Enterprise" -%}
                  <div class="send-way-wrapper g-details">
                    <span class="send-way-label">{{ translations.sendWay }}</span>
                    <div class="send-way-toggle">
                      <div class="radio-wrapper" onclick="changeSendWay('email')">
                        <div id="email" class="centerize wd-radio-circle">
                          <div id="inner-email" class="wd-radio-circle-selected-inner show-inner"></div>
                        </div>
                        <label class="radio-label" for="email">{{ translations.emailWay }}</label>
                      </div>

                      <div class="radio-wrapper" onclick="changeSendWay('phone')">
                        <div id="phone" class="centerize wd-radio-circle">
                          <div id="inner-phone" class="wd-radio-circle-selected-inner"></div>
                        </div>
                        <label class="radio-label" for="phone">{{ translations.smsWay }}</label>
                      </div>
                    </div>
                  </div>

                  <div id="phone-wrapper" class="full-width d-none g-details">
                    <div class="values-title" onclick="focusOnInputWd('phone-number-to-send')">{{ translations.phoneNumber }}</div>
                    <div class="with-prefix">
