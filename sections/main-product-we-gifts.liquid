                    {%-if hideExampleCode == false-%}
                  <div class="wd-card-code">AAAA-AAAA-AAAA-AAAA</div>
                  {%-endif%}
                  <div class="wd-card-price">0{{ currencySymbol }}</div>
                  </div>
                    <svg
                      onclick="getImagesSrcWd('[{{product.images}}]','inc')"
                      width="13"
                      height="13"
                      viewBox="0 0 13 13"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <g id="down-arrow 2" clip-path="url(#clip0_8282_3732)">
