<section
  id="MainProduct-{{ section.id }}"
  class="page-width-wg section-{{ section.id }}-padding wegifts-main"
  data-section="{{ section.id }}">
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-rte.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'wegifts-template.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}
      px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}
      px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}
        px;
        padding-bottom: {{ section.settings.padding_bottom }}
        px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'wd-wegifts.js' | asset_url }}" defer="defer"></script>
  {% assign translations = product.metafields.wegifts.translations.value %}
  {% assign targetPrice = product.metafields.wegifts.targetPrice %}
  {% assign currencySymbol = product.metafields.wegifts.currencySymbol %}
  {% assign useCustomAmount = product.metafields.wegifts.useCustomAmount %}
  {% assign shopPlan = product.metafields.wegifts.shopPlan %}
  {% assign shopName = product.metafields.wegifts.shopName %}
  {% assign shopLogoSrc = product.metafields.wegifts.shopLogo %}
  {% assign hideExampleCode = product.metafields.wegifts.hideExampleCode %}
  {% assign numImages = product.images.size %}
  {%- assign product_form_id = 'product-form-' | append: section.id -%}
  <div class="wd-card-description" style="margin-top:{{section.settings.margin-fmh}}px">

    <div class="wd-card-data">
      <div class="gap-div">
       
        <div id="wd-page-title-1" class="wd-page-title step-1">{{ translations.sendGiftCardTitle }}</div>
