        "template--16060343976076__4371b550-969b-4828-986d-71697fc53ef0-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>כשכל חליפות הספורט לנשים מחכות לך באתר אחד, החיים שלך הולכים להיות קלים.<br/>אנו סטרונגפול, מותג בגדי ספורט לנשים אונליין המספק לך את בגדי האימון לנשים הכי איכותיים שיש.<br/>כל בחורה צריכה סט ספורטיבי בארון, וכשהוא מסטרונגפול את יודעת שתוכלי לבחור את הגזרות, המידות והצבעים המדוייקים בשבילך שיגרמו לך להרגיש בשיא שלך.</p>"
          }
