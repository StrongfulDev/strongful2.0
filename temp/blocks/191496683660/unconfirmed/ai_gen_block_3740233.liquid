{% doc %}
  @prompt
    Create a popup discount that appears only when a user adds a third item to their cart. The popup should display a discount message and be styled to match the Strongful brand.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-popup-discount-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: center;
  }

  .ai-popup-discount-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 30px;
    max-width: 90%;
    width: 500px;
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-popup-discount-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
    padding: 0;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-popup-discount-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-popup-discount-title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 15px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-popup-discount-message-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 20px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-popup-discount-code-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background_color }};
    color: {{ block.settings.code_text_color }};
    padding: 12px 15px;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
    margin: 15px auto;
    max-width: 200px;
    letter-spacing: 1px;
    border: 1px dashed {{ block.settings.code_text_color }};
  }

  .ai-popup-discount-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 200px;
    margin: 20px auto 0;
    padding: 12px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }

  .ai-popup-discount-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-popup-discount-container-{{ ai_gen_id }} {
      padding: 20px;
      width: 90%;
    }

    .ai-popup-discount-title-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-popup-discount-message-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<cart-popup-discount-{{ ai_gen_id }} 
  class="ai-popup-discount-{{ ai_gen_id }}"
  data-threshold="{{ block.settings.item_threshold }}"
  data-discount-code="{{ block.settings.discount_code }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-popup-discount-container-{{ ai_gen_id }}">
    <button class="ai-popup-discount-close-{{ ai_gen_id }}" aria-label="Close popup">
      &times;
    </button>
    
    <h2 class="ai-popup-discount-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    
    <div class="ai-popup-discount-message-{{ ai_gen_id }}">{{ block.settings.message }}</div>
    
    {% if block.settings.show_discount_code %}
      <div class="ai-popup-discount-code-{{ ai_gen_id }}">{{ block.settings.discount_code }}</div>
    {% endif %}
    
    <a href="{{ block.settings.button_link }}" class="ai-popup-discount-button-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </a>
  </div>
</cart-popup-discount-{{ ai_gen_id }}>

<script>
  (function() {
    class CartPopupDiscount extends HTMLElement {
      constructor() {
        super();
        this.threshold = parseInt(this.dataset.threshold, 10) || 3;
        this.discountCode = this.dataset.discountCode;
        this.closeButton = this.querySelector('.ai-popup-discount-close-{{ ai_gen_id }}');
        this.isShown = false;
        this.popupShownKey = 'cartPopupShown_{{ ai_gen_id }}';
      }

      connectedCallback() {
        this.setupEventListeners();
        this.checkCartAndShowPopup();
      }

      setupEventListeners() {
        // Close button event
        this.closeButton.addEventListener('click', () => {
          this.hidePopup();
          this.setPopupShown();
        });

        // Listen for cart changes
        document.addEventListener('cart:refresh', this.checkCartAndShowPopup.bind(this));
        
        // Close when clicking outside the popup
        this.addEventListener('click', (event) => {
          if (event.target === this) {
            this.hidePopup();
            this.setPopupShown();
          }
        });

        // Listen for cart update events from Shopify
        document.addEventListener('cart:updated', this.checkCartAndShowPopup.bind(this));
        document.addEventListener('cart:refresh', this.checkCartAndShowPopup.bind(this));
      }

      checkCartAndShowPopup() {
        fetch('/cart.js')
          .then(response => response.json())
          .then(cart => {
            const itemCount = cart.item_count;
            
            if (itemCount >= this.threshold && !this.isPopupShown()) {
              this.showPopup();
            }
          })
          .catch(error => console.error('Error fetching cart:', error));
      }

      showPopup() {
        if (!this.isShown) {
          this.style.display = 'flex';
          this.isShown = true;
          document.body.style.overflow = 'hidden';
        }
      }

      hidePopup() {
        this.style.display = 'none';
        this.isShown = false;
        document.body.style.overflow = '';
      }

      isPopupShown() {
        return sessionStorage.getItem(this.popupShownKey) === 'true';
      }

      setPopupShown() {
        sessionStorage.setItem(this.popupShownKey, 'true');
      }
    }

    customElements.define('cart-popup-discount-{{ ai_gen_id }}', CartPopupDiscount);
  })();
</script>

{% schema %}
{
  "name": "Cart Discount Popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Discount Settings"
    },
    {
      "type": "range",
      "id": "item_threshold",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Item threshold",
      "info": "Show popup when cart has this many items"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "SAVE15"
    },
    {
      "type": "checkbox",
      "id": "show_discount_code",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You've Unlocked a Special Offer!"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Congratulations! You've added 3 items to your cart and unlocked a special discount. Use the code below at checkout.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "code_background_color",
      "label": "Discount code background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "code_text_color",
      "label": "Discount code text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Cart Discount Popup"
    }
  ]
}
{% endschema %}